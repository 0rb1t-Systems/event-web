# ─── EventHub Laravel API ──────────────────────────────────────────────────────

# Development:
# http://localhost:8002/api/v1
#
# Production example:
# https://api.example.com/api/v1

VITE_API_BASE_URL=http://localhost:8002/api/v1

# Public API client identifier.
# This value is visible in browser JavaScript by design.
# It is sent as the X-API-Key header on every Laravel API request.
VITE_API_KEY=

# ─── Web App ──────────────────────────────────────────────────────────────────

VITE_APP_NAME=EventHub

# Use the actual Vite dev URL for this repository.
VITE_APP_URL=http://localhost:8080

# ─── Payments / Display ───────────────────────────────────────────────────────

# WaafiPay itself is called by Laravel, never directly from this frontend.
VITE_WAAFI_CURRENCY=USD
